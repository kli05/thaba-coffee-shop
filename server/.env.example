# Copy to .env for local work. NEVER commit .env
PORT=4000

# Upstash / Redis connection URL (rediss://default:PASSWORD@HOST:6379).
# Leave empty for a temporary in-memory store (data is lost on restart).
REDIS_URL=

STAFF_USERNAME=staff
STAFF_PASSWORD=change-me
JWT_SECRET=long-random-string

# Comma-separated list of allowed frontend origins (your Netlify URL). Empty = allow all (dev only).
CLIENT_ORIGIN=http://localhost:5173

# Lesotho is UTC+2 (used for the "daily" summary)
TZ_OFFSET_MINUTES=120
